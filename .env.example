APP_NAME=Document Intelligence Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./backend/rag_metadata.db
